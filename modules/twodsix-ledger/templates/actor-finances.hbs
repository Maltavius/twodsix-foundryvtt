<div class="finance-ledger">

  {{!-- Totals --}}
  <section class="fl-totals {{finance.totals.totalClass}}">
    <div class="fl-total-main">
      <span class="fl-label">{{localize "TWODSIX_LEDGER.TOTAL_FUNDS"}}</span>
      <span class="fl-total-value">{{finance.totals.total}} <span class="fl-unit">Cr</span></span>
    </div>
    {{#if finance.totals.showNetOfDebt}}
    <div class="fl-total-net">
      <span class="fl-label">{{localize "TWODSIX_LEDGER.NET_OF_DEBT"}}</span>
      <span class="fl-net-value">{{finance.totals.netOfDebt}} Cr</span>
    </div>
    {{/if}}
  </section>

  {{!-- Cash and digital --}}
  <section class="fl-accounts">
    <div class="fl-account fl-card cash" data-account="cash">
      <span class="fl-card-title"><i class="fa-solid fa-money-bill-wave"></i> {{localize "TWODSIX_LEDGER.CASH"}}</span>
      <div class="fl-card-value">
        <input name="system.finances.cash" type="text" value="{{system.finances.cash}}" placeholder="0" aria-label="{{localize 'TWODSIX_LEDGER.CASH'}}"/>
        <span class="fl-unit">Cr</span>
      </div>
      <span class="fl-hint">{{localize "TWODSIX_LEDGER.CASH_HINT"}} <i class="fa-solid fa-pen"></i></span>
    </div>
    <div class="fl-account fl-card digital fl-nosubmit" data-account="digital">
      <span class="fl-card-title"><i class="fa-solid fa-credit-card"></i> {{localize "TWODSIX_LEDGER.DIGITAL"}}</span>
      <div class="fl-card-value">
        {{!-- Digital is kept by this module, not by the system, so this input has no name and is handled by the module --}}
        <input type="text" data-digital-input value="{{finance.digitalText}}" placeholder="0" aria-label="{{localize 'TWODSIX_LEDGER.DIGITAL'}}"/>
        <span class="fl-unit">Cr</span>
      </div>
      <span class="fl-hint">{{localize "TWODSIX_LEDGER.DIGITAL_HINT"}} <i class="fa-solid fa-pen"></i></span>
    </div>
  </section>

  {{!-- The four groups that match the old fields: Pension, Living costs, Ship payments and Debt. Click a card to
        open its list. --}}
  <section class="fl-groups fl-nosubmit" data-recurring>
    <div class="fl-group-cards">
      {{#each finance.groups.cards}}
      <button type="button" class="fl-group-card {{#if open}}is-open{{/if}}" data-group="{{key}}" data-action="financeToggleGroup" aria-expanded="{{#if open}}true{{else}}false{{/if}}">
        <span class="fl-group-label">{{label}}</span>
        <span class="fl-group-values">
          {{#each amounts}}<span class="fl-group-amount {{className}}">{{value}}{{#if unit}} <span class="fl-unit">{{unit}}</span>{{/if}}</span>{{/each}}
        </span>
        <span class="fl-group-sub">{{subText}} {{#if open}}▴{{else}}▾{{/if}}</span>
      </button>
      {{/each}}
    </div>

    {{#if finance.groups.hasPanel}}
    {{#with finance.groups.panel}}
    <div class="fl-group-panel" data-panel="{{key}}">
      <div class="fl-panel-head">
        <span class="item-title">{{label}}</span>
        <span class="fl-calendar-note" data-tooltip="{{localize 'TWODSIX_LEDGER.CALENDAR_TOOLTIP'}}">
          {{#if @root.finance.groups.gameDate}}<i class="fa-solid fa-calendar-days"></i> {{@root.finance.groups.gameDate}}{{else}}<i class="fa-solid fa-circle-info"></i> {{localize "TWODSIX_LEDGER.CALENDAR_SHORT"}}{{/if}}
        </span>
        <button type="button" class="fl-panel-close" data-action="financeToggleGroup" data-group="{{key}}">{{localize "TWODSIX_LEDGER.CLOSE"}} ▴</button>
      </div>

      {{#if hasRows}}
      <ul class="fl-rec-list">
        {{#if isDebt}}
        {{#each rows}}
        <li class="fl-rec" data-loan-id="{{id}}">
          <div class="fl-rec-main">
            <input type="text" class="fl-rec-name" data-loan-field="name" value="{{name}}" placeholder="{{localize 'TWODSIX_LEDGER.LOAN_NAME'}}" aria-label="{{localize 'TWODSIX_LEDGER.LOAN_NAME'}}"/>
            <label class="fl-rec-labeled"><span class="fl-hint">{{localize "TWODSIX_LEDGER.REMAINING"}}</span>
              <input type="text" class="fl-rec-amount" data-loan-field="remaining" value="{{remainingText}}" inputmode="text"/></label>
          </div>
          <div class="fl-rec-extra">
            <label class="fl-rec-labeled"><span class="fl-hint">{{localize "TWODSIX_LEDGER.MONTHLY_PAYMENT"}}</span>
              <input type="text" class="fl-rec-amount" data-loan-field="monthly" value="{{monthlyText}}" inputmode="text" placeholder="0"/></label>
            <select class="fl-rec-account" data-loan-field="account" aria-label="{{localize 'TWODSIX_LEDGER.ACCOUNT'}}">
              {{#each accounts}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <span class="fl-rec-actions">
              <button type="button" class="fl-rec-pay" data-action="financeLoanPay" data-id="{{id}}" {{#unless canPay}}disabled{{/unless}} {{#if payHint}}data-tooltip="{{payHint}}"{{/if}}>{{payLabel}}</button>
              <button type="button" class="fl-rec-payother" data-action="financeLoanPayCustom" data-id="{{id}}" {{#unless canPayCustom}}disabled{{/unless}}>{{localize "TWODSIX_LEDGER.PAY_OTHER"}}</button>
              <button type="button" class="fl-rec-delete" data-action="financeLoanDelete" data-id="{{id}}" aria-label="{{localize 'TWODSIX_LEDGER.DELETE_ITEM'}}" data-tooltip="{{localize 'TWODSIX_LEDGER.DELETE_ITEM'}}"><i class="fa-solid fa-xmark"></i></button>
            </span>
          </div>
        </li>
        {{/each}}
        {{else}}
        {{#each rows}}
        <li class="fl-rec {{#unless active}}is-off{{/unless}}" data-rec-id="{{id}}">
          <div class="fl-rec-main">
            <input type="checkbox" class="fl-rec-active" data-rec-field="active" {{#if active}}checked{{/if}} aria-label="{{localize 'TWODSIX_LEDGER.ACTIVE'}}" data-tooltip="{{localize 'TWODSIX_LEDGER.ACTIVE'}}"/>
            <input type="text" class="fl-rec-name" data-rec-field="name" value="{{name}}" placeholder="{{localize 'TWODSIX_LEDGER.ITEM_NAME'}}" aria-label="{{localize 'TWODSIX_LEDGER.ITEM_NAME'}}"/>
            <input type="text" class="fl-rec-amount {{amountClass}}" data-rec-field="amount" value="{{amountText}}" inputmode="text" aria-label="{{localize 'TWODSIX_LEDGER.AMOUNT_COLUMN'}}"/>
            <select class="fl-rec-freq" data-rec-field="frequency" aria-label="{{localize 'TWODSIX_LEDGER.FREQUENCY'}}">
              {{#each frequencies}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
          <div class="fl-rec-extra">
            <select class="fl-rec-account" data-rec-field="account" aria-label="{{localize 'TWODSIX_LEDGER.ACCOUNT'}}">
              {{#each accounts}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <span class="fl-rec-actions">
              <button type="button" class="fl-rec-pay" data-action="financeRecPay" data-id="{{id}}" {{#unless canPay}}disabled{{/unless}} {{#if payHint}}data-tooltip="{{payHint}}"{{/if}}>{{payLabel}}</button>
              <button type="button" class="fl-rec-delete" data-action="financeRecDelete" data-id="{{id}}" aria-label="{{localize 'TWODSIX_LEDGER.DELETE_ITEM'}}" data-tooltip="{{localize 'TWODSIX_LEDGER.DELETE_ITEM'}}"><i class="fa-solid fa-xmark"></i></button>
            </span>
          </div>
        </li>
        {{/each}}
        {{/if}}
      </ul>
      {{else}}
      <p class="fl-empty">{{#if isDebt}}{{localize "TWODSIX_LEDGER.NO_LOANS"}}{{else}}{{localize "TWODSIX_LEDGER.NO_RECURRING"}}{{/if}}</p>
      {{/if}}

      <div class="fl-rec-foot">
        {{#if isDebt}}
        <button type="button" class="fl-rec-add" data-action="financeLoanTake"><i class="fa-solid fa-plus"></i> {{localize "TWODSIX_LEDGER.TAKE_LOAN"}}</button>
        <button type="button" class="fl-rec-add" data-action="financeLoanAdd" data-tooltip="{{localize 'TWODSIX_LEDGER.ADD_EXISTING_LOAN_HINT'}}"><i class="fa-solid fa-plus"></i> {{localize "TWODSIX_LEDGER.ADD_EXISTING_LOAN"}}</button>
        {{else}}
        <button type="button" class="fl-rec-add" data-action="financeRecAdd" data-group="{{key}}"><i class="fa-solid fa-plus"></i> {{localize "TWODSIX_LEDGER.ADD_ITEM"}}</button>
        {{/if}}
        <span class="fl-rec-summary">{{footerText}}</span>
      </div>
      {{#unless isDebt}}<p class="fl-hint">{{localize "TWODSIX_LEDGER.RECURRING_HINT"}}</p>{{/unless}}
    </div>
    {{/with}}
    {{/if}}
  </section>

  {{!-- History title with the buttons that open the form below it --}}
  <section class="fl-history-bar fl-nosubmit">
    <span class="item-title">{{localize "TWODSIX_LEDGER.HISTORY"}}</span>
    {{#if finance.editable}}
    <div class="fl-bar-buttons">
      <button type="button" class="fl-bar-button {{#if finance.addFormOpen}}is-open{{/if}}" data-action="financeToggleForm" data-mode="add" aria-expanded="{{#if finance.addFormOpen}}true{{else}}false{{/if}}"><i class="fa-solid fa-plus"></i> {{localize "TWODSIX_LEDGER.ADD_TRANSACTION"}} {{#if finance.addFormOpen}}▴{{else}}▾{{/if}}</button>
      <button type="button" class="fl-bar-button {{#if finance.moveFormOpen}}is-open{{/if}}" data-action="financeToggleForm" data-mode="move" aria-expanded="{{#if finance.moveFormOpen}}true{{else}}false{{/if}}"><i class="fa-solid fa-right-left"></i> {{localize "TWODSIX_LEDGER.MOVE_MONEY"}} {{#if finance.moveFormOpen}}▴{{else}}▾{{/if}}</button>
    </div>
    {{/if}}
  </section>

  {{!-- Add transaction / move money --}}
  {{#if finance.editable}}
  {{#if finance.formOpen}}
  <section class="fl-form fl-nosubmit" data-mode="{{finance.mode}}">
    <div class="fl-form-row">
      <label class="fl-field fl-amount">
        <span class="fl-label">{{localize "TWODSIX_LEDGER.AMOUNT"}}</span>
        <input type="text" inputmode="text" autocomplete="off" data-draft="amount" data-submit-on-enter value="{{finance.draft.amount}}" placeholder="-200"/>
      </label>
      {{#if finance.isMoveMode}}
      <label class="fl-field">
        <span class="fl-label">{{localize "TWODSIX_LEDGER.FROM"}}</span>
        <select data-draft="from">
          {{#each finance.fromAccounts}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="fl-field">
        <span class="fl-label">{{localize "TWODSIX_LEDGER.TO"}}</span>
        <select data-draft="to">
          {{#each finance.toAccounts}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{else}}
      <label class="fl-field">
        <span class="fl-label">{{localize "TWODSIX_LEDGER.PAID_WITH"}}</span>
        <select data-draft="account">
          {{#each finance.addAccounts}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="fl-field">
        <span class="fl-label">{{localize "TWODSIX_LEDGER.CATEGORY"}}</span>
        <select data-draft="category">
          {{#each finance.categoryOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
    </div>

    <div class="fl-form-row">
      <label class="fl-field fl-description">
        <span class="fl-label">{{localize "TWODSIX_LEDGER.DESCRIPTION"}}</span>
        <input type="text" autocomplete="off" data-draft="description" data-submit-on-enter value="{{finance.draft.description}}"/>
      </label>
      {{#if finance.isMoveMode}}
      <button type="button" class="fl-submit" data-kind="neutral" data-action="financeMove"><span class="fl-button-label">{{localize "TWODSIX_LEDGER.MOVE_BUTTON"}}</span></button>
      {{else}}
      <button type="button" class="fl-submit" data-kind="{{finance.button.kind}}" data-action="financeAdd"><span class="fl-button-label">{{finance.button.label}}</span></button>
      {{/if}}
    </div>
    <p class="fl-hint">{{#if finance.isMoveMode}}{{localize "TWODSIX_LEDGER.MOVE_HINT"}}{{else}}{{localize "TWODSIX_LEDGER.AMOUNT_HINT"}}{{/if}}</p>
    <p class="fl-error" role="alert" aria-live="polite" hidden></p>
  </section>
  {{/if}}
  {{/if}}

  {{!-- History --}}
  <section class="fl-history fl-nosubmit">
    <div class="fl-history-head">
      <div class="fl-filters" role="group" aria-label="{{localize 'TWODSIX_LEDGER.ACCOUNT'}}">
        {{#each finance.filters}}
        <button type="button" class="fl-filter {{#if active}}active{{/if}}" data-action="financeFilter" data-filter="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
        {{/each}}
      </div>
      <input type="search" class="fl-search" data-role="search" value="{{finance.search}}" placeholder="{{localize 'TWODSIX_LEDGER.SEARCH'}}" aria-label="{{localize 'TWODSIX_LEDGER.SEARCH'}}"/>
      {{#if finance.editable}}
      <button type="button" class="fl-undo" data-action="financeUndo" {{#unless finance.canUndo}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> {{localize "TWODSIX_LEDGER.UNDO_LAST"}}</button>
      {{/if}}
    </div>

    <div class="fl-scroll">
      {{#if finance.rows.length}}
      <table class="fl-table">
        <thead>
          <tr>
            <th class="fl-col-date">{{localize "TWODSIX_LEDGER.DATE_IN_GAME"}}</th>
            <th class="fl-col-desc">{{localize "TWODSIX_LEDGER.DESCRIPTION"}}</th>
            <th class="fl-col-account">{{localize "TWODSIX_LEDGER.ACCOUNT"}}</th>
            <th class="fl-col-amount">{{localize "TWODSIX_LEDGER.AMOUNT_COLUMN"}}</th>
            <th class="fl-col-balance">{{localize "TWODSIX_LEDGER.BALANCE"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each finance.rows}}
          <tr class="fl-row">
            <td class="fl-col-date {{#if isRealDate}}real-date{{/if}}" {{#if isRealDate}}data-tooltip="{{localize 'TWODSIX_LEDGER.REAL_DATE_TOOLTIP'}}"{{/if}}>{{dateText}}</td>
            <td class="fl-col-desc"><span class="fl-desc-text">{{description}}</span>{{#if showCategory}}<span class="fl-category fl-cat-{{categoryKey}}">{{categoryLabel}}</span>{{/if}}<span class="fl-category fl-account-inline">{{accountText}}</span></td>
            <td class="fl-col-account"><span class="fl-accounts-cell {{#if isTransfer}}fl-transfer{{/if}}">{{#each accountPills}}{{#if @first}}<span class="fl-pill {{key}}">{{label}}</span>{{else}}<span class="fl-pill-after"><span class="fl-arrow" aria-hidden="true">→</span><span class="fl-pill {{key}}">{{label}}</span></span>{{/if}}{{/each}}</span></td>
            <td class="fl-col-amount {{amountClass}}">{{#if isTransfer}}<i class="fa-solid fa-right-left fl-transfer-icon" data-tooltip="{{localize 'TWODSIX_LEDGER.CATEGORIES.transfer'}}"></i> {{/if}}{{amountText}}</td>
            <td class="fl-col-balance">{{balanceText}}</td>
          </tr>
          {{/each}}
          {{#if finance.opening}}
          <tr class="fl-row fl-opening">
            <td class="fl-col-date"></td>
            <td class="fl-col-desc"><span class="fl-desc-text">{{localize "TWODSIX_LEDGER.OPENING_BALANCE"}}</span></td>
            <td class="fl-col-account"></td>
            <td class="fl-col-amount"></td>
            <td class="fl-col-balance">{{finance.opening.text}}</td>
          </tr>
          {{/if}}
        </tbody>
      </table>
      {{else}}
      <p class="fl-empty">{{#if finance.noMatches}}{{localize "TWODSIX_LEDGER.NO_MATCHES"}}{{else}}{{localize "TWODSIX_LEDGER.NO_TRANSACTIONS"}}{{/if}}</p>
      {{/if}}
      {{#if finance.hasMore}}
      <button type="button" class="fl-more" data-action="financeMore">{{localize "TWODSIX_LEDGER.SHOW_MORE_COUNT" count=finance.hiddenCount}}</button>
      {{/if}}
    </div>
  </section>

  {{!-- Notes (unchanged field) --}}
  <section class="financial-notes">
    <span class="item-title">{{localize "TWODSIX.Actor.Finances.FINANCIAL_NOTES"}}</span>
    <div contenteditable="true" data-edit="system.finances.financial-notes">{{{system.finances.financial-notes}}}</div>
  </section>
</div>
