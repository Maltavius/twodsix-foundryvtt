{{!-- Twodsix Ledger: the module's copy of the system's actor-items.hbs (twodsix 7.7.1). Changed: carried items get
     the tl-equipped class and a "Not equipped" line before the rest; weapons have status chips after the name (loaded
     magazine, Auto) that open the rows with fire mode buttons and the loaded magazine, instead of the Consumables list;
     loaded magazines are left out of the Consumables list; armour has a radiation column and secondary protection as
     (+X); Equipment & Tools has a weight column; Storage & Junk and armour have their own column classes. Compare
     with the system's file when the system changes it. --}}
{{!-- Sheet Body --}}
<div class="character-tabs-info character-inventory tl-inventory">
   <!-- WEAPONS -->
  <div><span class="pusher"></span>
    <span class="item-title">{{localize "TWODSIX.Actor.Items.WEAPONS"}}</span>
    <div class="items-weapons gear-header">
      <span></span>
      <span class="item-name">{{localize "TWODSIX.Actor.Items.Name"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.TL"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Qty"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Weight"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Range"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Damage"}}</span>
      <span class="item-name centre">
        <a class="item-control item-create" data-tooltip='{{localize "TWODSIX.Actor.Items.CreateItem"}}' data-type="weapon" data-action="itemCreate"><i class="fa-solid fa-plus"></i></a>
        <a class="item-control item-viewToggle" data-item-type="weapon" data-action="toggleView">
          {{#unless system.hideStoredItems.weapon}}
            <i class="fa-solid fa-eye" data-tooltip='{{localize "TWODSIX.Actor.Items.DisplayStored"}}'></i>
          {{else}}
            <i class="fa-solid fa-eye-slash" data-tooltip='{{localize "TWODSIX.Actor.Items.HideStored"}}'></i>
          {{/unless}}
        </a>
      </span>
    </div>
    <section class="item-list">
      {{#each container.weapon as |item id|}}
      {{#unless (twodsix_hideItem ../system.hideStoredItems.weapon item.system.equipped)}}
      {{#if (lookup @root.inventory.groupStart item.id)}}<div class="tl-group-divider">{{localize "TWODSIX_LEDGER.INVENTORY.NOT_EQUIPPED"}}</div>{{/if}}
      <div class="item gear draggable{{#iff item.system.equipped "===" "equipped"}} tl-equipped{{/iff}}" data-item-id="{{item.id}}">
        <ol class="ol-no-indent">
          <li class="flexrow">
            <span class="items-weapons">
              <span class="mini-dice perform-attack" data-tooltip="{{twodsix_invertSkillRollShiftClick}}" data-label="{{item.name}}" data-action="performAttack"><i class="fa-solid fa-dice" alt="d6" ></i></span>
              <span class="item-name perform-attack tl-weapon-name" data-label="{{item.name}}" data-action="performAttack">
                <span class="tl-name-text">{{item.name}}</span>
                {{#with (lookup @root.inventory.weapons item.id) as |w|}}
                {{#if w.hasDetails}}
                <a class="tl-status" data-action="inventoryToggleDetails" data-tooltip="{{w.toggleTooltip}}">
                  {{#if w.ammo}}
                    {{#if w.ammo.loaded}}
                    <span class="tl-chip tl-chip-{{w.ammo.state}}">{{w.ammo.current}}/{{w.ammo.max}}</span>
                    {{else}}
                    <span class="tl-chip tl-chip-unloaded">{{localize "TWODSIX_LEDGER.INVENTORY.UNLOADED"}}</span>
                    {{/if}}
                  {{/if}}
                  {{#if w.auto}}<span class="tl-chip tl-chip-auto">{{localize "TWODSIX.Rolls.Auto"}} {{w.auto}}</span>{{/if}}
                  <i class="fa-solid {{#if w.open}}fa-chevron-up{{else}}fa-chevron-down{{/if}} tl-status-caret"></i>
                </a>
                {{/if}}
                {{/with}}
              </span>
              <span class="item-name centre">{{item.system.techLevel}}</span>
              <span class="item-name centre">{{item.system.quantity}}</span>
              <span class="item-name centre">{{item.system.weight}}</span>
              {{#if ../settings.ShowRangeBandAndHideRange}}
              <span class="item-name centre" data-tooltip='{{localize (concat "TWODSIX.Chat.Roll.WeaponRangeTypes." item.system.rangeBand)}}'>{{localize (lookup ../settings.rangeTypes item.system.rangeBand)}}</span>
              {{else if item.displayRange}}
              <span class="item-name centre" data-tooltip="{{item.displayRange.tooltip}}">{{item.displayRange.text}}</span>
              {{else}}
              <span class="item-name centre">{{item.system.range}}</span>
              {{/if}}
              <span class="item-name centre roll-damage" data-action="rollDamage">{{twodsix_limitLength item.system.damage 8}}</span>
              <span class="item-controls centre tl-controls">
                {{#unless item.system.useConsumableForAttack}}
                {{#unless item.system.consumableData}}
                {{#iff item.system.ammo ">" 0}}
                  <a class="item-control item-fill-consumable" data-tooltip='{{localize "TWODSIX.Actor.Items.Refill"}}' data-action="autoCreateConsumable"><i class="fa-solid fa-battery-full"></i></a>
                {{/iff}}
                {{/unless}}{{/unless}}
                <a class="item-control item-toggle" data-tooltip='{{localize (concat "TWODSIX.Actor.Items.LocationState." item.system.equipped)}}' data-action="toggleItem"><i class="{{twodsix_getEquippedIcon item.system.equipped}}"></i></a>
                <a class="item-control item-chat" data-tooltip='{{localize "TWODSIX.Actor.Items.SendToChat"}}' data-action="showChat"><i class="fa-solid fa-message"></i></a>
                <a class="item-control item-edit" data-tooltip='{{localize "TWODSIX.Actor.Items.EditItem"}}' data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></a>
                <a class="item-control item-delete" data-tooltip='{{localize "TWODSIX.Actor.Items.DeleteItem"}}' data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
              </span>
            </span>
          </li>
          {{#if (lookup (lookup @root.inventory.weapons item.id) "open")}}
          {{!-- Fire modes: every button is one attack in that mode; the last one used is marked (on this client) --}}
          <li class="tl-fire-modes">
            <span class="tl-row-label">{{localize "TWODSIX_LEDGER.INVENTORY.FIRE_MODE"}}</span>
            {{#if ../settings.useCEAutofireRules}}
              {{#if (twodsix_burstModes item)}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="single" data-rof="1" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Single"}}</button>
              {{/if}}
              {{#each (twodsix_burstModes item) as |mode|}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-rof="{{mode}}" data-attack-type="burst-attack-dm" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Burst"}} {{mode}}: +{{twodsix_burstAttackDM mode}} {{localize "TWODSIX.Rolls.AttackDM"}}</button>
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-rof="{{mode}}" data-attack-type="burst-bonus-damage" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Burst"}} {{mode}}: +{{twodsix_burstBonusDamage mode}} {{localize "TWODSIX.Rolls.Damage"}}</button>
              {{/each}}
            {{else if ../settings.useCELAutofireRules}}
              {{#if (twodsix_useCELAuto item)}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="single" data-rof="1" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Single"}}</button>
                {{#iff item.system.doubleTap "&&" ../settings.ShowDoubleTap}}
                  <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="double-tap" data-rof="2" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.DoubleTap"}}</button>
                {{else}}
                  <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="auto-burst" data-rof="{{item.system.rateOfFire}}" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.BurstDamage"}}</button>
                  <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="auto-full" data-rof="{{item.system.rateOfFire}}" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.FullAuto"}}</button>
                {{/iff}}
              {{/if}}
            {{else if ../settings.useCTAutofireRules}}
              {{#if (twodsix_useCTAuto item)}}
                {{#if (twodsix_useCTSingle item)}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="single" data-rof="1" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Single"}}</button>
                {{/if}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="auto-full" data-rof="{{twodsix_CTBurstSize item}}" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.FullAuto"}}</button>
              {{/if}}
            {{else if ../settings.useCUAutofireRules}}
              {{#if (twodsix_useCUAuto item)}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="single" data-rof="1" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Single"}}</button>
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="auto-full" data-rof="{{item.system.rateOfFire}}" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.FullAuto"}}</button>
              {{/if}}
            {{else if ../settings.useRIDERFireRules}}
              {{#if (twodsix_useRIDERMulti item)}}
                <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="single" data-rof="1" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Single"}}</button>
                {{#iff item.system.rateOfFire ">" 1}}
                  <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="multi" data-rof="{{item.system.rateOfFire}}" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Multi"}} ({{item.system.rateOfFire}})</button>
                {{/iff}}
                {{#if item.system.isSingleAction}}
                  <button type="button" class="tl-fire-mode" data-action="inventoryFireMode" data-attack-type="fan" data-rof="3" data-tooltip="{{twodsix_invertSkillRollShiftClick}}">{{localize "TWODSIX.Rolls.Fan"}}</button>
                {{/if}}
              {{/if}}
            {{/if}}
          </li>
          {{!-- The loaded magazine. The system's - and + buttons, green check and edit button read the consumable-row ids --}}
          {{#with (lookup (lookup @root.inventory.weapons item.id) "ammo") as |ammo|}}
          <li class="tl-ammo tl-ammo-{{ammo.state}}{{#if ammo.loaded}} consumable-row{{/if}}"{{#if ammo.loaded}} data-consumable-id="{{ammo.loaded.id}}" data-parent-id="{{item.id}}"{{/if}}>
            <span class="tl-row-label">{{localize "TWODSIX_LEDGER.INVENTORY.LOADED"}}</span>
            {{#if ammo.loaded}}
              <span class="tl-ammo-bar" aria-hidden="true"><span style="width: {{ammo.percent}}%"></span></span>
              <span class="tl-ammo-count">{{ammo.current}}/{{ammo.max}}</span>
              <span class="combined-buttons">
                <button type="button" class="left-button adjust-consumable" data-action="adjustConsumable" data-value="1" {{#iff ammo.current "<=" 0}}disabled{{/iff}}>-</button>
                <button type="button" class="right-button adjust-consumable" data-action="adjustConsumable" data-value="-1" {{#if ammo.full}}disabled{{/if}}>+</button>
              </span>
              <span class="tl-ammo-text" data-tooltip="{{ammo.loaded.name}}">{{ammo.loaded.name}} · {{ammo.text}}</span>
            {{else}}
              <span class="tl-badge">{{localize "TWODSIX_LEDGER.INVENTORY.UNLOADED"}}</span>
              <span class="tl-ammo-text">{{ammo.text}}</span>
            {{/if}}
            <span class="tl-ammo-actions">
              {{#if ammo.canReload}}
              <button type="button" class="tl-reload" data-action="inventoryReload"
                data-tooltip="{{#if ammo.loaded}}{{localize 'TWODSIX_LEDGER.INVENTORY.RELOAD'}}{{else}}{{localize 'TWODSIX_LEDGER.INVENTORY.LOAD'}}{{/if}}"
                aria-label="{{#if ammo.loaded}}{{localize 'TWODSIX_LEDGER.INVENTORY.RELOAD'}}{{else}}{{localize 'TWODSIX_LEDGER.INVENTORY.LOAD'}}{{/if}}">
                <i class="fa-solid fa-rotate"></i>{{#if ammo.multiple}}<i class="fa-solid fa-caret-down"></i>{{/if}}
              </button>
              {{/if}}
              {{#if ammo.loaded}}
              <span class="item-controls">
                <a class="consumable-toggle" data-consumable-id="{{ammo.loaded.id}}" data-parent-id="{{item.id}}" data-action="toggleConsumable" style="color: green;" data-tooltip="{{localize 'TWODSIX.Items.Consumable.ActiveConsumable'}}"><i class="fa-solid fa-circle-check"></i></a>
                <a class="item-control consumable-edit" data-tooltip='{{localize "TWODSIX.Actor.Items.EditItem"}}' data-action="editConsumable"><i class="fa-solid fa-pen-to-square"></i></a>
              </span>
              {{/if}}
            </span>
          </li>
          {{/with}}
          {{/if}}
        </ol>
        {{#if item.system.attachmentData}}
          <details class="attachment-list" {{#if item.showAttachmentsList}}open{{/if}} data-action="toggleAttachmentsList" data-item-id="{{item.id}}">
            <summary>{{localize "TWODSIX.Actor.Items.Attachments"}}</summary>
            {{#each item.system.attachmentData as |attachmentData|}}
            {{> "systems/twodsix/templates/actors/parts/actor/actor-consumable.hbs" attachmentData consumableId=attachmentData._id parentId= ../item.id parentItem= ../item}}
            {{/each}}
          </details>
        {{/if}}
      </div>
      {{/unless}}
      {{/each}}
    </section>
  </div>

  <!-- ARMOR -->
  <div><span class="pusher"></span>
    <span class="item-title">{{localize "TWODSIX.Actor.Items.ARMOR"}}</span>
    <div class="items-armor tl-armor gear-header">
      <span></span>
      <span class="item-name">{{localize "TWODSIX.Actor.Items.Name"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.TL"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Qty"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Weight"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Armor"}}</span>
      <span class="item-name centre" data-tooltip='{{localize "TWODSIX.Items.Armor.RadProt"}}'>{{localize "TWODSIX_LEDGER.INVENTORY.RAD_HEADER"}}</span>
      <span class="item-name centre">
        <a class="item-control item-create" data-tooltip='{{localize "TWODSIX.Actor.Items.CreateItem"}}' data-type="armor" data-action="itemCreate"><i class="fa-solid fa-plus"></i></a>
        <a class="item-control item-viewToggle" data-item-type="armor" data-action="toggleView">
          {{#unless system.hideStoredItems.armor}}
          <i class="fa-solid fa-eye" data-tooltip='{{localize "TWODSIX.Actor.Items.DisplayStored"}}'></i></a>
          {{else}}
          <i class="fa-solid fa-eye-slash" data-tooltip='{{localize "TWODSIX.Actor.Items.HideStored"}}'></i></a>
          {{/unless}}
      </span>
    </div>

    <section class="item-list">
      {{#each container.armor as |item id|}}
      {{#unless (twodsix_hideItem ../system.hideStoredItems.armor item.system.equipped)}}
      {{#if (lookup @root.inventory.groupStart item.id)}}<div class="tl-group-divider">{{localize "TWODSIX_LEDGER.INVENTORY.NOT_EQUIPPED"}}</div>{{/if}}
      <div class="item gear draggable{{#iff item.system.equipped "===" "equipped"}} tl-equipped{{/iff}}" data-item-id="{{item.id}}">
        <ol class="ol-no-indent">
          <li class="flexrow" >
            <span class="items-armor tl-armor">
              <span class="mini-dice rollable" data-tooltip="{{twodsix_invertSkillRollShiftClick}}" data-label="{{item.name}}" data-action="skillTalentRoll"><i class="fa-solid fa-dice" alt="d6" ></i></span>
              <span class="item-name rollable" data-action="skillTalentRoll">
                {{item.name}}
                {{#if item.system.nonstackable}}
                  {{#iff item.system.equipped "===" "equipped"}}
                    <i class="fa-solid fa-layer-group red" data-tooltip='{{localize "TWODSIX.Items.Armor.Nonstackable"}}'></i>
                  {{else}}
                    <i class="fa-solid fa-layer-group" data-tooltip='{{localize "TWODSIX.Items.Armor.Nonstackable"}}'></i>
                  {{/iff}}
                {{/if}}
              </span>
              <span class="item-name centre">{{item.system.techLevel}}</span>
              <span class="item-name centre">{{item.system.quantity}}</span>
              <span class="item-name centre">{{item.system.weight}}</span>
              {{#if ../settings.useCTData}}
                <span class="item-name centre">{{localize (concat 'TWODSIX.Chat.Roll.ArmorTypes.' item.system.armorType)}}</span>
              {{else if ../settings.useCUData}}
                <span class="item-name centre">{{item.system.secondaryArmor.value}}</span>
              {{else}}
                <span class="item-name centre">{{item.system.armor}}{{#with (lookup @root.inventory.armor item.id) as |armor|}}{{#if armor.secondary}}
                  <span class="tl-secondary" data-tooltip="{{armor.tooltip}}">(+{{armor.secondary}})</span>{{/if}}{{/with}}</span>
              {{/if}}
              <span class="item-name centre">{{item.system.radiationProtection.value}}</span>
              {{> "systems/twodsix/templates/actors/parts/actor/actor-core-buttons.hbs" item= item settings= ../settings}}
            </span>
          </li>
        </ol>
        {{> "systems/twodsix/templates/actors/parts/actor/actor-attachment-consumable-list.hbs" item= item settings= ../settings}}
      </div>
      {{/unless}}
      {{/each}}
    </section>
  </div>

  <!-- AUGMENTS -->
  <div><span class="pusher"></span>
    <span class="item-title">{{localize "TWODSIX.Actor.Items.AUGMENTS"}}</span>
    <div class="items-augments gear-header">
      <span></span>
      <span class="item-name">{{localize "TWODSIX.Actor.Items.Name"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.TL"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Qty"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Effect"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Location"}}</span>
      <span class="item-name centre">
        <a class="item-control item-create" data-tooltip='{{localize "TWODSIX.Actor.Items.CreateItem"}}' data-type="augment" data-action="itemCreate"><i class="fa-solid fa-plus"></i></a>
        <a class="item-control item-viewToggle" data-item-type="augment" data-action="toggleView">
          {{#unless system.hideStoredItems.augment}}
          <i class="fa-solid fa-eye" data-tooltip='{{localize "TWODSIX.Actor.Items.DisplayStored"}}'></i></a>
          {{else}}
          <i class="fa-solid fa-eye-slash" data-tooltip='{{localize "TWODSIX.Actor.Items.HideStored"}}'></i></a>
          {{/unless}}
      </span>
    </div>
    <section class="item-list">
      {{#each container.augment as |item id|}}
      {{#unless (twodsix_hideItem ../system.hideStoredItems.augment item.system.equipped)}}
      {{#if (lookup @root.inventory.groupStart item.id)}}<div class="tl-group-divider">{{localize "TWODSIX_LEDGER.INVENTORY.NOT_EQUIPPED"}}</div>{{/if}}
      <div class="item gear draggable{{#iff item.system.equipped "===" "equipped"}} tl-equipped{{/iff}}" data-item-id="{{item.id}}">
        <ol class="ol-no-indent">
          <li class="flexrow">
            <span class="items-augments">
              <span class="mini-dice rollable" data-tooltip="{{twodsix_invertSkillRollShiftClick}}"data-label="{{item.name}}" data-action="skillTalentRoll"><i class="fa-solid fa-dice" alt="d6" ></i></span>
              <span class="item-name rollable" data-action="skillTalentRoll">{{item.name}}</span>
              <span class="item-name centre">{{item.system.techLevel}}</span>
              <span class="item-name centre">{{item.system.quantity}}</span>
              <span class="item-name centre">{{item.system.bonus}}</span>
              <span class="item-name centre">{{item.system.auglocation}}</span>
              {{> "systems/twodsix/templates/actors/parts/actor/actor-core-buttons.hbs" item= item settings= ../settings}}
            </span>
          </li>
        </ol>
        {{> "systems/twodsix/templates/actors/parts/actor/actor-attachment-consumable-list.hbs" item= item settings= ../settings}}
      </div>
      {{/unless}}
      {{/each}}
    </section>
  </div>

  <!-- EQUIPMENT -->
  <div><span class="pusher"></span>
    <span class="item-title">{{localize "TWODSIX.Actor.Items.EQUIPMENT_TOOLS"}}</span>
    <div class="items-equipment gear-header">
      <span></span>
      <span class="item-name">{{localize "TWODSIX.Actor.Items.Name"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.TL"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Qty"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.Weight"}}</span>
      <span class="item-name centre">{{localize "TWODSIX.Actor.Items.ShortDescr"}}</span>
      <span class="item-name centre">
        <a class="item-control item-create" data-tooltip='{{localize "TWODSIX.Actor.Items.CreateItem"}}' data-type="equipment" data-action="itemCreate"><i class="fa-solid fa-plus"></i></a>
        <a class="item-control item-viewToggle" data-item-type="equipment" data-action="toggleView">
          {{#unless system.hideStoredItems.equipment}}
          <i class="fa-solid fa-eye" data-tooltip='{{localize "TWODSIX.Actor.Items.DisplayStored"}}'></i></a>
          {{else}}
          <i class="fa-solid fa-eye-slash" data-tooltip='{{localize "TWODSIX.Actor.Items.HideStored"}}'></i></a>
          {{/unless}}
      </span>
    </div>
      <section class="item-list">
        {{#each container.equipmentAndTools as |item id|}}
        {{#unless (twodsix_hideItem ../system.hideStoredItems.equipment item.system.equipped)}}
        {{#if (lookup @root.inventory.groupStart item.id)}}<div class="tl-group-divider">{{localize "TWODSIX_LEDGER.INVENTORY.NOT_EQUIPPED"}}</div>{{/if}}
        <div class="item gear draggable{{#iff item.system.equipped "===" "equipped"}} tl-equipped{{/iff}}" data-item-id="{{item.id}}">
          <ol class="ol-no-indent">
            <li class="flexrow">
                <span class="items-equipment">
                  <span class="mini-dice rollable" data-tooltip="{{twodsix_invertSkillRollShiftClick}}" data-label="{{item.name}}" data-action="skillTalentRoll"><i class="fa-solid fa-dice" alt="d6" ></i></span>
                  <span class="item-name rollable" data-action="skillTalentRoll">{{item.name}}</span>
                  <span class="item-name centre">{{item.system.techLevel}}</span>
                  <span class="item-name centre">{{item.system.quantity}}</span>
                  <span class="item-name centre">{{item.system.weight}}</span>
                  {{#iff item.type "===" "computer"}}
                    <span class="item-name centre">{{localize "TWODSIX.Items.Computer.ProcessingPower"}}: {{twodsix_getProcessingPower item}}/{{item.system.processingPower}}</span>
                  {{else}}
                    <span class="item-name centre">{{item.system.shortdescr}}</span>
                  {{/iff}}
                  {{> "systems/twodsix/templates/actors/parts/actor/actor-core-buttons.hbs" item= item settings= ../settings}}
                </span>
            </li>
          </ol>
